msgid "Table %(table)s wasn't found in the database %(db)s"
msgstr "টেবিল %(table)s ডেটাবেস %(db)s এ পাওয়া যায়নি"

msgid "Table Name"
msgstr "টেবিলের নাম"

#, python-format
msgid ""
"Table [%(table)s] could not be found, please double check your database "
"connection, schema, and table name"
msgstr "টেবিল [%(table)s] পাওয়া যায়নি, অনুগ্রহ করে আপনার ডেটাবেস সংযোগ, স্কিমা এবং টেবিলের নাম পুনরায় পরীক্ষা করুন"

msgid "Table actions"
msgstr "টেবিল ক্রিয়া"

msgid ""
"Table already exists. You can change your 'if table already exists' "
"strategy to append or replace or provide a different Table Name to use."
msgstr "টেবিল ইতিমধ্যে বিদ্যমান। আপনি আপনার 'যদি টেবিল ইতিমধ্যে বিদ্যমান থাকে' কৌশলটি যুক্ত করতে বা প্রতিস্থাপন করতে বা ব্যবহারের জন্য একটি ভিন্ন টেবিলের নাম সরবরাহ করতে পারেন।"

msgid "Table cache timeout"
msgstr "টেবিল ক্যাশে সময়সীমা"

msgid "Table columns"
msgstr "টেবিল কলাম"

msgid "Table name"
msgstr "টেবিলের নাম"

msgid "Table name undefined"
msgstr "টেবিলের নাম অনির্ধারিত"

#, python-format
msgid "Table or View \"%(table)s\" does not exist."
msgstr "টেবিল বা ভিউ \"%(table)s\" বিদ্যমান নেই।"

msgid ""
"Table that visualizes paired t-tests, which are used to understand "
"statistical differences between groups."
msgstr "টেবিল যা জোড়া টি-টেস্ট কল্পনা করে, যা গোষ্ঠীগুলির মধ্যে পরিসংখ্যানগত পার্থক্য বুঝতে ব্যবহৃত হয়।"

msgid "Tables"
msgstr "টেবিল"

msgid "Tabs"
msgstr "ট্যাব"

msgid "Tabular"
msgstr "সারণী"

msgid "Tag"
msgstr "ট্যাগ"

msgid "Tag could not be created."
msgstr "ট্যাগ তৈরি করা যায়নি।"

msgid "Tag could not be deleted."
msgstr "ট্যাগ মুছে ফেলা যায়নি।"

msgid "Tag could not be found."
msgstr "ট্যাগ পাওয়া যায়নি।"

msgid "Tag could not be updated."
msgstr "ট্যাগ আপডেট করা যায়নি।"

msgid "Tag created"
msgstr "ট্যাগ তৈরি করা হয়েছে"

msgid "Tag name"
msgstr "ট্যাগের নাম"

msgid "Tag name is invalid (cannot contain ':')"
msgstr "ট্যাগের নাম অবৈধ (':' থাকতে পারে না)"

msgid "Tag parameters are invalid."
msgstr "ট্যাগ প্যারামিটারগুলি অবৈধ।"

msgid "Tag updated"
msgstr "ট্যাগ আপডেট করা হয়েছে"

#, python-format
msgid "Tagged %s %ss"
msgstr "%s %ss ট্যাগ করা হয়েছে"

msgid "Tagged Object could not be deleted."
msgstr "ট্যাগ করা বস্তু মুছে ফেলা যায়নি।"

msgid "Tags"
msgstr "ট্যাগ"

msgid "Target"
msgstr "লক্ষ্য"

msgid "Target Color"
msgstr "লক্ষ্যের রঙ"

msgid "Target category"
msgstr "লক্ষ্য বিভাগ"

msgid "Target value"
msgstr "লক্ষ্য মান"

msgid "Template"
msgstr "টেমপ্লেট"

msgid "Template parameters"
msgstr "টেমপ্লেট প্যারামিটার"

msgid ""
"Templated link, it's possible to include {{ metric }} or other values "
"coming from the controls."
msgstr "টেমপ্লেটেড লিঙ্ক, নিয়ন্ত্রণগুলি থেকে আসা {{ metric }} বা অন্যান্য মান অন্তর্ভুক্ত করা সম্ভব।"

msgid "Temporal X-Axis"
msgstr "সাময়িক X-অক্ষ"

msgid ""
"Terminate running queries when browser window closed or navigated to "
"another page. Available for Presto, Hive, MySQL, Postgres and Snowflake "
"databases."
msgstr "ব্রাউজার উইন্ডো বন্ধ হয়ে গেলে বা অন্য পৃষ্ঠায় নেভিগেট করা হলে চলমান ক্যোয়ারীগুলি বন্ধ করুন। Presto, Hive, MySQL, Postgres এবং Snowflake ডেটাবেসের জন্য উপলব্ধ।"

msgid "Test Connection"
msgstr "সংযোগ পরীক্ষা করুন"

msgid "Test connection"
msgstr "সংযোগ পরীক্ষা করুন"

msgid "Text"
msgstr "পাঠ্য"

msgid "Text / Markdown"
msgstr "পাঠ্য / মার্কডাউন"

msgid "Text align"
msgstr "পাঠ্য বিন্যাস"

msgid "Text embedded in email"
msgstr "ইমেলের মধ্যে এমবেড করা পাঠ্য"

#, python-format
msgid "The API response from %s does not match the IDatabaseTable interface."
msgstr "%s থেকে API প্রতিক্রিয়া IDatabaseTable ইন্টারফেসের সাথে মেলে না।"

msgid ""
"The CSS for individual dashboards can be altered here, or in the "
"dashboard view where changes are immediately visible"
msgstr "স্বতন্ত্র ড্যাশবোর্ডের জন্য CSS এখানে বা ড্যাশবোর্ড ভিউতে পরিবর্তন করা যেতে পারে যেখানে পরিবর্তনগুলি অবিলম্বে দৃশ্যমান হয়"

msgid ""
"The CTAS (create table as select) doesn't have a SELECT statement at the "
"end. Please make sure your query has a SELECT as its last statement. "
"Then, try running your query again."
msgstr "CTAS (create table as select) এর শেষে একটি SELECT স্টেটমেন্ট নেই। অনুগ্রহ করে নিশ্চিত করুন যে আপনার ক্যোয়ারীর শেষ স্টেটমেন্ট হিসাবে একটি SELECT আছে। তারপর, আপনার ক্যোয়ারী আবার চালানোর চেষ্টা করুন।"

msgid ""
"The GeoJsonLayer takes in GeoJSON formatted data and renders it as "
"interactive polygons, lines and points (circles, icons and/or texts)."
msgstr "GeoJsonLayer GeoJSON ফর্ম্যাট করা ডেটা নেয় এবং এটিকে ইন্টারেক্টিভ বহুভুজ, লাইন এবং পয়েন্ট (বৃত্ত, আইকন এবং/অথবা পাঠ্য) হিসাবে রেন্ডার করে।"

msgid ""
"The Sankey chart visually tracks the movement and transformation of "
"values across\n"
"          system stages. Nodes represent stages, connected by links "
"depicting value flow. Node\n"
"          height corresponds to the visualized metric, providing a clear "
"representation of\n"
"          value distribution and transformation."
msgstr "সাঁকি চার্ট সিস্টেমের পর্যায় জুড়ে মানগুলির চলাচল এবং রূপান্তর দৃশ্যত ট্র্যাক করে। নোডগুলি পর্যায়গুলিকে প্রতিনিধিত্ব করে, যা মান প্রবাহকে চিত্রিত করে এমন লিঙ্ক দ্বারা সংযুক্ত থাকে। নোডের উচ্চতা ভিজ্যুয়ালাইজড মেট্রিকের সাথে মিলে যায়, যা মান বন্টন এবং রূপান্তরের একটি স্পষ্ট প্রতিনিধিত্ব প্রদান করে।"

msgid "The URL is missing the dataset_id or slice_id parameters."
msgstr "URL-এ dataset_id বা slice_id প্যারামিটার অনুপস্থিত।"

msgid "The X-axis is not on the filters list"
msgstr "X-অক্ষ ফিল্টার তালিকায় নেই"

msgid ""
"The X-axis is not on the filters list which will prevent it from being "
"used in\n"
"            time range filters in dashboards. Would you like to add it to"
" the filters list?"
msgstr "X-অক্ষ ফিল্টার তালিকায় নেই যা এটিকে ড্যাশবোর্ডে সময় পরিসীমা ফিল্টারে ব্যবহার করা থেকে বিরত রাখবে। আপনি কি এটিকে ফিল্টার তালিকায় যুক্ত করতে চান?"
msgid "The annotation has been saved"
msgstr "টীকাটি সংরক্ষণ করা হয়েছে"

msgid "The annotation has been updated"
msgstr "টীকাটি আপডেট করা হয়েছে"

msgid "The background color of the charts."
msgstr "চার্টগুলির পটভূমির রঙ।"

msgid ""
"The category of source nodes used to assign colors. If a node is "
"associated with more than one category, only the first will be used."
msgstr "রঙ নির্ধারণের জন্য ব্যবহৃত উৎস নোডগুলির বিভাগ। যদি একটি নোড একাধিক বিভাগের সাথে যুক্ত থাকে, তবে কেবল প্রথমটি ব্যবহার করা হবে।"

msgid "The chart datasource does not exist"
msgstr "চার্ট ডেটাসোর্স বিদ্যমান নেই"

msgid "The chart does not exist"
msgstr "চার্ট বিদ্যমান নেই"

msgid "The chart query context does not exist"
msgstr "চার্ট ক্যোয়ারী প্রসঙ্গ বিদ্যমান নেই"

msgid ""
"The classic. Great for showing how much of a company each investor gets, "
"what demographics follow your blog, or what portion of the budget goes to"
" the military industrial complex.\n"
"\n"
"        Pie charts can be difficult to interpret precisely. If clarity of"
" relative proportion is important, consider using a bar or other chart "
"type instead."
msgstr "ক্লাসিক। প্রতিটি বিনিয়োগকারী একটি কোম্পানির কতটা অংশ পায়, কোন জনসংখ্যাতাত্ত্বিক আপনার ব্লগ অনুসরণ করে, বা বাজেটের কোন অংশ সামরিক শিল্প কমপ্লেক্সে যায় তা দেখানোর জন্য দুর্দান্ত।\n"
"\n"
"        পাই চার্টগুলি সঠিকভাবে ব্যাখ্যা করা কঠিন হতে পারে। যদি আপেক্ষিক অনুপাতের স্বচ্ছতা গুরুত্বপূর্ণ হয়, তবে পরিবর্তে একটি বার বা অন্য চার্ট প্রকার ব্যবহার করার কথা বিবেচনা করুন।"

msgid "The color for points and clusters in RGB"
msgstr "RGB-তে পয়েন্ট এবং ক্লাস্টারের জন্য রঙ"

msgid "The color of the elements border"
msgstr "উপাদানগুলির সীমানার রঙ"

msgid "The color of the isoband"
msgstr "আইসোব্যান্ডের রঙ"

msgid "The color of the isoline"
msgstr "আইসোলাইনের রঙ"

msgid "The color scheme for rendering chart"
msgstr "চার্ট রেন্ডার করার জন্য রঙের স্কিম"

msgid ""
"The color scheme is determined by the related dashboard.\n"
"        Edit the color scheme in the dashboard properties."
msgstr "রঙের স্কিম সম্পর্কিত ড্যাশবোর্ড দ্বারা নির্ধারিত হয়।\n"
"        ড্যাশবোর্ড বৈশিষ্ট্যগুলিতে রঙের স্কিম সম্পাদনা করুন।"

msgid ""
"The colors of this chart might be overridden by custom label colors of "
"the related dashboard.\n"
"    Check the JSON metadata in the Advanced settings."
msgstr "এই চার্টের রঙগুলি সম্পর্কিত ড্যাশবোর্ডের কাস্টম লেবেল রঙ দ্বারা ওভাররাইড করা হতে পারে।\n"
"    উন্নত সেটিংসে JSON মেটাডেটা পরীক্ষা করুন।"

msgid "The column header label"
msgstr "কলাম হেডার লেবেল"

msgid "The column to be used as the source of the edge."
msgstr "প্রান্তের উৎস হিসাবে ব্যবহৃত কলাম।"

msgid "The column to be used as the target of the edge."
msgstr "প্রান্তের লক্ষ্য হিসাবে ব্যবহৃত কলাম।"

msgid "The column was deleted or renamed in the database."
msgstr "কলামটি ডেটাবেস থেকে মুছে ফেলা বা পুনঃনামকরণ করা হয়েছে।"

msgid "The configuration for the map layers"
msgstr "মানচিত্র স্তরগুলির জন্য কনফিগারেশন"

msgid "The corner radius of the chart background"
msgstr "চার্ট পটভূমির কোণার ব্যাসার্ধ"

msgid ""
"The country code standard that Superset should expect to find in the "
"[country] column"
msgstr "সুপারসেট [দেশ] কলামে যে দেশের কোড স্ট্যান্ডার্ড খুঁজে পাওয়ার আশা করে"

msgid "The dashboard has been saved"
msgstr "ড্যাশবোর্ডটি সংরক্ষণ করা হয়েছে"

msgid "The data source seems to have been deleted"
msgstr "ডেটা উৎসটি মুছে ফেলা হয়েছে বলে মনে হচ্ছে"

msgid "The database"
msgstr "ডেটাবেস"

msgid "The database columns that contains lines information"
msgstr "লাইন তথ্য ধারণকারী ডেটাবেস কলাম"

msgid "The database could not be found"
msgstr "ডেটাবেসটি খুঁজে পাওয়া যায়নি"

msgid "The database is currently running too many queries."
msgstr "ডেটাবেসটি বর্তমানে অনেকগুলি ক্যোয়ারী চালাচ্ছে।"

msgid "The database is under an unusual load."
msgstr "ডেটাবেসটি একটি অস্বাভাবিক লোডের অধীনে রয়েছে।"

msgid ""
"The database referenced in this query was not found. Please contact an "
"administrator for further assistance or try again."
msgstr "এই ক্যোয়ারীতে উল্লেখিত ডেটাবেসটি খুঁজে পাওয়া যায়নি। আরও সহায়তার জন্য অনুগ্রহ করে একজন প্রশাসকের সাথে যোগাযোগ করুন বা আবার চেষ্টা করুন।"

msgid "The database returned an unexpected error."
msgstr "ডেটাবেসটি একটি অপ্রত্যাশিত ত্রুটি ফিরিয়েছে।"

msgid "The database that was used to generate this query could not be found"
msgstr "এই ক্যোয়ারী তৈরি করতে ব্যবহৃত ডেটাবেসটি খুঁজে পাওয়া যায়নি"

msgid "The database was deleted."
msgstr "ডেটাবেসটি মুছে ফেলা হয়েছে।"

msgid "The database was not found."
msgstr "ডেটাবেসটি খুঁজে পাওয়া যায়নি।"

msgid "The dataset"
msgstr "ডেটাসেট"

msgid "The dataset associated with this chart no longer exists"
msgstr "এই চার্টের সাথে যুক্ত ডেটাসেটটি আর বিদ্যমান নেই"

msgid "The dataset column/metric that returns the values on your chart's x-axis."
msgstr "ডেটাসেট কলাম/মেট্রিক যা আপনার চার্টের x-অক্ষে মান প্রদান করে।"

msgid "The dataset column/metric that returns the values on your chart's y-axis."
msgstr "ডেটাসেট কলাম/মেট্রিক যা আপনার চার্টের y-অক্ষে মান প্রদান করে।"

msgid ""
"The dataset configuration exposed here\n"
"                affects all the charts using this dataset.\n"
"                Be mindful that changing settings\n"
"                here may affect other charts\n"
"                in undesirable ways."
msgstr "এখানে প্রকাশিত ডেটাসেট কনফিগারেশন\n"
"                এই ডেটাসেট ব্যবহার করে সমস্ত চার্টকে প্রভাবিত করে।\n"
"                মনে রাখবেন যে এখানে সেটিংস পরিবর্তন করা\n"
"                অন্যান্য চার্টকে\n"
"                অনাকাঙ্ক্ষিত উপায়ে প্রভাবিত করতে পারে।"

msgid "The dataset has been saved"
msgstr "ডেটাসেটটি সংরক্ষণ করা হয়েছে"

msgid "The dataset linked to this chart may have been deleted."
msgstr "এই চার্টের সাথে লিঙ্ক করা ডেটাসেটটি মুছে ফেলা হতে পারে।"

msgid "The datasource couldn't be loaded"
msgstr "ডেটাসোর্স লোড করা যায়নি"

msgid "The datasource is too large to query."
msgstr "ডেটাসোর্সটি ক্যোয়ারী করার জন্য খুব বড়।"

msgid "The default catalog that should be used for the connection."
msgstr "সংযোগের জন্য ব্যবহৃত ডিফল্ট ক্যাটালগ।"

msgid "The default schema that should be used for the connection."
msgstr "সংযোগের জন্য ব্যবহৃত ডিফল্ট স্কিমা।"

msgid ""
"The description can be displayed as widget headers in the dashboard view."
" Supports markdown."
msgstr "বর্ণনাটি ড্যাশবোর্ড ভিউতে উইজেট হেডার হিসাবে প্রদর্শিত হতে পারে। মার্কডাউন সমর্থন করে।"

msgid "The distance between cells, in pixels"
msgstr "কোষগুলির মধ্যে দূরত্ব, পিক্সেলে"

msgid ""
"The duration of time in seconds before the cache is invalidated. Set to "
"-1 to bypass the cache."
msgstr "ক্যাশে অবৈধ হওয়ার আগে সেকেন্ডে সময়ের সময়কাল। ক্যাশে বাইপাস করতে -1 এ সেট করুন।"

msgid "The encoding format of the lines"
msgstr "লাইনগুলির এনকোডিং ফর্ম্যাট"

msgid ""
"The engine_params object gets unpacked into the sqlalchemy.create_engine "
"call."
msgstr "engine_params অবজেক্টটি sqlalchemy.create_engine কলে আনপ্যাক করা হয়।"

msgid "The exponent to compute all sizes from. \"EXP\" only"
msgstr "সমস্ত আকার গণনা করার জন্য সূচক। শুধুমাত্র \"EXP\""

msgid ""
"The extent of the map on application start. FIT DATA automatically sets "
"the extent so that all data points are included in the viewport. CUSTOM "
"allows users to define the extent manually."
msgstr "অ্যাপ্লিকেশন শুরুতে মানচিত্রের ব্যাপ্তি। FIT DATA স্বয়ংক্রিয়ভাবে ব্যাপ্তি সেট করে যাতে সমস্ত ডেটা পয়েন্ট ভিউপোর্টে অন্তর্ভুক্ত থাকে। CUSTOM ব্যবহারকারীদের ম্যানুয়ালি ব্যাপ্তি নির্ধারণ করতে দেয়।"

#, python-format
msgid ""
"The following entries in `series_columns` are missing in `columns`: "
"%(columns)s. "
msgstr "`series_columns`-এর নিম্নলিখিত এন্ট্রিগুলি `columns`-এ অনুপস্থিত: %(columns)s।"

#, python-format
msgid ""
"The following filters have the 'Select first filter value by default'\n"
"                    option checked and could not be loaded, which is "
"preventing the dashboard\n"
"                    from rendering: %s"
msgstr "নিম্নলিখিত ফিল্টারগুলিতে 'ডিফল্টরূপে প্রথম ফিল্টার মান নির্বাচন করুন' বিকল্পটি চেক করা আছে এবং লোড করা যায়নি, যা ড্যাশবোর্ড রেন্ডারিং থেকে বাধা দিচ্ছে: %s"

msgid "The function to use when aggregating points into groups"
msgstr "পয়েন্টগুলিকে গ্রুপে একত্রিত করার সময় ব্যবহৃত ফাংশন"

msgid "The height of the current zoom level to compute all heights from"
msgstr "সমস্ত উচ্চতা গণনা করার জন্য বর্তমান জুম স্তরের উচ্চতা"

msgid ""
"The histogram chart displays the distribution of a dataset by\n"
"          representing the frequency or count of values within different "
"ranges or bins.\n"
"          It helps visualize patterns, clusters, and outliers in the data"
" and provides\n"
"          insights into its shape, central tendency, and spread."
msgstr "হিস্টোগ্রাম চার্ট একটি ডেটাসেটের বন্টন প্রদর্শন করে বিভিন্ন পরিসর বা বিনে মানগুলির ফ্রিকোয়েন্সি বা গণনা উপস্থাপন করে। এটি ডেটাতে প্যাটার্ন, ক্লাস্টার এবং আউটলায়ারগুলি কল্পনা করতে সহায়তা করে এবং এর আকৃতি, কেন্দ্রীয় প্রবণতা এবং বিস্তারের অন্তর্দৃষ্টি প্রদান করে।"

#, python-format
msgid "The host \"%(hostname)s\" might be down and can't be reached."
msgstr "হোস্ট \"%(hostname)s\" ডাউন হতে পারে এবং পৌঁছানো যাচ্ছে না।"

#, python-format
msgid ""
"The host \"%(hostname)s\" might be down, and can't be reached on port "
"%(port)s."
msgstr "হোস্ট \"%(hostname)s\" ডাউন হতে পারে, এবং পোর্ট %(port)s-এ পৌঁছানো যাচ্ছে না।"

msgid "The host might be down, and can't be reached on the provided port."
msgstr "হোস্ট ডাউন হতে পারে, এবং প্রদত্ত পোর্টে পৌঁছানো যাচ্ছে না।"

#, python-format
msgid "The hostname \"%(hostname)s\" cannot be resolved."
msgstr "হোস্টনাম \"%(hostname)s\" সমাধান করা যাচ্ছে না।"

msgid "The hostname provided can't be resolved."
msgstr "প্রদত্ত হোস্টনাম সমাধান করা যাচ্ছে না।"

msgid "The id of the active chart"
msgstr "সক্রিয় চার্টের আইডি"

msgid "The layer attribution"
msgstr "স্তরের অ্যাট্রিবিউশন"

msgid "The lower limit of the threshold range of the Isoband"
msgstr "আইসোব্যান্ডের থ্রেশহোল্ড পরিসরের নিম্ন সীমা"

msgid ""
"The maximum number of subdivisions of each group; lower values are pruned"
" first"
msgstr "প্রতিটি গ্রুপের উপবিভাগের সর্বোচ্চ সংখ্যা; নিম্ন মানগুলি প্রথমে ছাঁটাই করা হয়"

msgid "The maximum value of metrics. It is an optional configuration"
msgstr "মেট্রিকের সর্বোচ্চ মান। এটি একটি ঐচ্ছিক কনফিগারেশন"

#, python-format
msgid ""
"The metadata_params in Extra field is not configured correctly. The key "
"%(key)s is invalid."
msgstr "অতিরিক্ত ক্ষেত্রের metadata_params সঠিকভাবে কনফিগার করা হয়নি। কী %(key)s অবৈধ।"

msgid ""
"The metadata_params in Extra field is not configured correctly. The key "
"%{key}s is invalid."
msgstr "অতিরিক্ত ক্ষেত্রের metadata_params সঠিকভাবে কনফিগার করা হয়নি। কী %{key}s অবৈধ।"

msgid ""
"The metadata_params object gets unpacked into the sqlalchemy.MetaData "
"call."
msgstr "metadata_params অবজেক্টটি sqlalchemy.MetaData কলে আনপ্যাক করা হয়।"

msgid ""
"The minimum number of rolling periods required to show a value. For "
"instance if you do a cumulative sum on 7 days you may want your \"Min "
"Period\" to be 7, so that all data points shown are the total of 7 "
"periods. This will hide the \"ramp up\" taking place over the first 7 "
"periods"
msgstr "একটি মান দেখানোর জন্য প্রয়োজনীয় রোলিং পিরিয়ডের সর্বনিম্ন সংখ্যা। উদাহরণস্বরূপ, যদি আপনি ৭ দিনের উপর একটি ক্রমবর্ধমান যোগফল করেন তবে আপনি আপনার \"ন্যূনতম সময়কাল\" ৭ হতে চাইতে পারেন, যাতে দেখানো সমস্ত ডেটা পয়েন্ট ৭টি সময়কালের মোট হয়। এটি প্রথম ৭টি সময়কালে সংঘটিত \"র‍্যাম্প আপ\" লুকিয়ে রাখবে।"

msgid ""
"The minimum value of metrics. It is an optional configuration. If not "
"set, it will be the minimum value of the data"
msgstr "মেট্রিকের সর্বনিম্ন মান। এটি একটি ঐচ্ছিক কনফিগারেশন। যদি সেট না করা হয়, তবে এটি ডেটার সর্বনিম্ন মান হবে"

msgid "The name of the geometry column"
msgstr "জ্যামিতি কলামের নাম"

msgid "The name of the layer as described in GetCapabilities"
msgstr "GetCapabilities-এ বর্ণিত স্তরের নাম"

msgid "The name of the rule must be unique"
msgstr "নিয়মের নাম অবশ্যই অনন্য হতে হবে"

msgid "The number color \"steps\""
msgstr "সংখ্যা রঙের \"ধাপ\""

msgid "The number of bins for the histogram"
msgstr "হিস্টোগ্রামের জন্য বিনের সংখ্যা"

msgid ""
"The number of hours, negative or positive, to shift the time column. This"
" can be used to move UTC time to local time."
msgstr "সময় কলামটি শিফট করার জন্য ঘন্টার সংখ্যা, ঋণাত্মক বা ধনাত্মক। এটি ইউটিসি সময়কে স্থানীয় সময়ে স্থানান্তর করতে ব্যবহার করা যেতে পারে।"

#, python-format
msgid ""
"The number of results displayed is limited to %(rows)d by the "
"configuration DISPLAY_MAX_ROW. Please add additional limits/filters or "
"download to csv to see more rows up to the %(limit)d limit."
msgstr "প্রদর্শিত ফলাফলের সংখ্যা DISPLAY_MAX_ROW কনফিগারেশন দ্বারা %(rows)d-এ সীমাবদ্ধ। অনুগ্রহ করে অতিরিক্ত সীমা/ফিল্টার যোগ করুন বা %(limit)d সীমা পর্যন্ত আরও সারি দেখতে csv-তে ডাউনলোড করুন।"

#, python-format
msgid ""
"The number of results displayed is limited to %(rows)d. Please add "
"additional limits/filters, download to csv, or contact an admin to see "
"more rows up to the %(limit)d limit."
msgstr "প্রদর্শিত ফলাফলের সংখ্যা %(rows)d-এ সীমাবদ্ধ। অনুগ্রহ করে অতিরিক্ত সীমা/ফিল্টার যোগ করুন, csv-তে ডাউনলোড করুন, বা %(limit)d সীমা পর্যন্ত আরও সারি দেখতে একজন প্রশাসকের সাথে যোগাযোগ করুন।"

#, python-format
msgid "The number of rows displayed is limited to %(rows)d by the dropdown."
msgstr "প্রদর্শিত সারির সংখ্যা ড্রপডাউন দ্বারা %(rows)d-এ সীমাবদ্ধ।"

#, python-format
msgid "The number of rows displayed is limited to %(rows)d by the limit dropdown."
msgstr "প্রদর্শিত সারির সংখ্যা সীমা ড্রপডাউন দ্বারা %(rows)d-এ সীমাবদ্ধ।"

#, python-format
msgid "The number of rows displayed is limited to %(rows)d by the query"
msgstr "প্রদর্শিত সারির সংখ্যা ক্যোয়ারী দ্বারা %(rows)d-এ সীমাবদ্ধ"

#, python-format
msgid ""
"The number of rows displayed is limited to %(rows)d by the query and "
"limit dropdown."
msgstr "প্রদর্শিত সারির সংখ্যা ক্যোয়ারী এবং সীমা ড্রপডাউন দ্বারা %(rows)d-এ সীমাবদ্ধ।"

msgid "The number of seconds before expiring the cache"
msgstr "ক্যাশে মেয়াদ শেষ হওয়ার আগে সেকেন্ডের সংখ্যা"

msgid "The object does not exist in the given database."
msgstr "বস্তুটি প্রদত্ত ডেটাবেসে বিদ্যমান নেই।"

#, python-format
msgid "The parameter %(parameters)s in your query is undefined."
msgid_plural "The following parameters in your query are undefined: %(parameters)s."
msgstr[0] "আপনার ক্যোয়ারীতে %(parameters)s প্যারামিটারটি অনির্ধারিত।"
msgstr[1] "আপনার ক্যোয়ারীতে নিম্নলিখিত প্যারামিটারগুলি অনির্ধারিত: %(parameters)s।"

#, python-format
msgid "The password provided for username \"%(username)s\" is incorrect."
msgstr "ব্যবহারকারীর নাম \"%(username)s\"-এর জন্য প্রদত্ত পাসওয়ার্ডটি ভুল।"

msgid "The password provided when connecting to a database is not valid."
msgstr "একটি ডেটাবেসের সাথে সংযোগ করার সময় প্রদত্ত পাসওয়ার্ডটি বৈধ নয়।"

msgid ""
"The passwords for the databases below are needed in order to import them "
"together with the charts. Please note that the \"Secure Extra\" and "
"\"Certificate\" sections of the database configuration are not present in"
" export files, and should be added manually after the import if they are "
"needed."
msgstr "নীচের ডেটাবেসগুলির পাসওয়ার্ডগুলি চার্টগুলির সাথে একসাথে আমদানি করার জন্য প্রয়োজন। অনুগ্রহ করে মনে রাখবেন যে ডেটাবেস কনফিগারেশনের \"সিকিওর এক্সট্রা\" এবং \"সার্টিফিকেট\" বিভাগগুলি এক্সপোর্ট ফাইলগুলিতে উপস্থিত নেই, এবং প্রয়োজনে আমদানির পরে ম্যানুয়ালি যোগ করা উচিত।"

msgid ""
"The passwords for the databases below are needed in order to import them "
"together with the dashboards. Please note that the \"Secure Extra\" and "
"\"Certificate\" sections of the database configuration are not present in"
" export files, and should be added manually after the import if they are "
"needed."
msgstr "নীচের ডেটাবেসগুলির পাসওয়ার্ডগুলি ড্যাশবোর্ডগুলির সাথে একসাথে আমদানি করার জন্য প্রয়োজন। অনুগ্রহ করে মনে রাখবেন যে ডেটাবেস কনফিগারেশনের \"সিকিওর এক্সট্রা\" এবং \"সার্টিফিকেট\" বিভাগগুলি এক্সপোর্ট ফাইলগুলিতে উপস্থিত নেই, এবং প্রয়োজনে আমদানির পরে ম্যানুয়ালি যোগ করা উচিত।"

msgid ""
"The passwords for the databases below are needed in order to import them "
"together with the datasets. Please note that the \"Secure Extra\" and "
"\"Certificate\" sections of the database configuration are not present in"
" export files, and should be added manually after the import if they are "
"needed."
msgstr "নীচের ডেটাবেসগুলির পাসওয়ার্ডগুলি ডেটাসেটগুলির সাথে একসাথে আমদানি করার জন্য প্রয়োজন। অনুগ্রহ করে মনে রাখবেন যে ডেটাবেস কনফিগারেশনের \"সিকিওর এক্সট্রা\" এবং \"সার্টিফিকেট\" বিভাগগুলি এক্সপোর্ট ফাইলগুলিতে উপস্থিত নেই, এবং প্রয়োজনে আমদানির পরে ম্যানুয়ালি যোগ করা উচিত।"

msgid ""
"The passwords for the databases below are needed in order to import them "
"together with the saved queries. Please note that the \"Secure Extra\" "
"and \"Certificate\" sections of the database configuration are not "
"present in export files, and should be added manually after the import if"
" they are needed."
msgstr "নীচের ডেটাবেসগুলির পাসওয়ার্ডগুলি সংরক্ষিত ক্যোয়ারীগুলির সাথে একসাথে আমদানি করার জন্য প্রয়োজন। অনুগ্রহ করে মনে রাখবেন যে ডেটাবেস কনফিগারেশনের \"সিকিওর এক্সট্রা\" এবং \"সার্টিফিকেট\" বিভাগগুলি এক্সপোর্ট ফাইলগুলিতে উপস্থিত নেই, এবং প্রয়োজনে আমদানির পরে ম্যানুয়ালি যোগ করা উচিত।"

msgid ""
"The passwords for the databases below are needed in order to import them."
" Please note that the \"Secure Extra\" and \"Certificate\" sections of "
"the database configuration are not present in explore files and should be"
" added manually after the import if they are needed."
msgstr "নীচের ডেটাবেসগুলির পাসওয়ার্ডগুলি আমদানি করার জন্য প্রয়োজন। অনুগ্রহ করে মনে রাখবেন যে ডেটাবেস কনফিগারেশনের \"সিকিওর এক্সট্রা\" এবং \"সার্টিফিকেট\" বিভাগগুলি এক্সপ্লোর ফাইলগুলিতে উপস্থিত নেই এবং প্রয়োজনে আমদানির পরে ম্যানুয়ালি যোগ করা উচিত।"

msgid "The pattern of timestamp format. For strings use "
msgstr "টাইমস্ট্যাম্প বিন্যাসের প্যাটার্ন। স্ট্রিংগুলির জন্য ব্যবহার করুন"

msgid ""
"The periodicity over which to pivot time. Users can provide\n"
"            \"Pandas\" offset alias.\n"
"            Click on the info bubble for more details on accepted "
"\"freq\" expressions."
msgstr "সময় পিভট করার সময়কাল। ব্যবহারকারীরা \"পান্ডাস\" অফসেট উপনাম প্রদান করতে পারেন। গৃহীত \"freq\" এক্সপ্রেশন সম্পর্কে আরও বিস্তারিত জানার জন্য তথ্য বুদবুদে ক্লিক করুন।"

msgid "The pixel radius"
msgstr "পিক্সেল ব্যাসার্ধ"

msgid ""
"The pointer to a physical table (or view). Keep in mind that the chart is"
" associated to this Superset logical table, and this logical table points"
" the physical table referenced here."
msgstr "একটি ভৌত টেবিল (বা ভিউ) এর পয়েন্টার। মনে রাখবেন যে চার্টটি এই সুপারসেট লজিক্যাল টেবিলের সাথে যুক্ত, এবং এই লজিক্যাল টেবিলটি এখানে উল্লেখিত ভৌত টেবিলকে নির্দেশ করে।"

msgid "The port is closed."
msgstr "পোর্টটি বন্ধ।"

msgid "The port number is invalid."
msgstr "পোর্ট নম্বরটি অবৈধ।"

msgid "The primary metric is used to define the arc segment sizes"
msgstr "প্রাথমিক মেট্রিকটি আর্ক সেগমেন্টের আকার নির্ধারণ করতে ব্যবহৃত হয়"

msgid "The provided table was not found in the provided database"
msgstr "প্রদত্ত টেবিলটি প্রদত্ত ডেটাবেসে পাওয়া যায়নি"

msgid "The query associated with the results was deleted."
msgstr "ফলাফলের সাথে যুক্ত ক্যোয়ারীটি মুছে ফেলা হয়েছে।"

msgid ""
"The query associated with these results could not be found. You need to "
"re-run the original query."
msgstr "এই ফলাফলগুলির সাথে যুক্ত ক্যোয়ারীটি খুঁজে পাওয়া যায়নি। আপনাকে মূল ক্যোয়ারীটি পুনরায় চালাতে হবে।"

msgid "The query contains one or more malformed template parameters."
msgstr "ক্যোয়ারীতে এক বা একাধিক ত্রুটিপূর্ণ টেমপ্লেট প্যারামিটার রয়েছে।"

msgid "The query couldn't be loaded"
msgstr "ক্যোয়ারী লোড করা যায়নি"

#, python-format
msgid ""
"The query estimation was killed after %(sqllab_timeout)s seconds. It "
"might be too complex, or the database might be under heavy load."
msgstr "ক্যোয়ারী অনুমান %(sqllab_timeout)s সেকেন্ড পরে বন্ধ করা হয়েছিল। এটি খুব জটিল হতে পারে, অথবা ডেটাবেস ভারী লোডের অধীনে থাকতে পারে।"

msgid "The query has a syntax error."
msgstr "ক্যোয়ারীতে একটি সিনট্যাক্স ত্রুটি আছে।"

msgid "The query returned no data"
msgstr "ক্যোয়ারী কোনো ডেটা ফেরত দেয়নি"

#, python-format
msgid ""
"The query was killed after %(sqllab_timeout)s seconds. It might be too "
"complex, or the database might be under heavy load."
msgstr "ক্যোয়ারীটি %(sqllab_timeout)s সেকেন্ড পরে বন্ধ করা হয়েছিল। এটি খুব জটিল হতে পারে, অথবা ডেটাবেস ভারী লোডের অধীনে থাকতে পারে।"

msgid ""
"The radius (in pixels) the algorithm uses to define a cluster. Choose 0 "
"to turn off clustering, but beware that a large number of points (>1000) "
"will cause lag."
msgstr "ব্যাসার্ধ (পিক্সেলে) যা অ্যালগরিদম একটি ক্লাস্টার নির্ধারণ করতে ব্যবহার করে। ক্লাস্টারিং বন্ধ করতে ০ বেছে নিন, তবে সতর্ক থাকুন যে বিপুল সংখ্যক পয়েন্ট (>১০০০) ল্যাগের কারণ হবে।"

msgid ""
"The radius of individual points (ones that are not in a cluster). Either "
"a numerical column or `Auto`, which scales the point based on the largest"
" cluster"
msgstr "স্বতন্ত্র পয়েন্টগুলির ব্যাসার্ধ (যেগুলি একটি ক্লাস্টারে নেই)। হয় একটি সংখ্যাসূচক কলাম বা `অটো`, যা বৃহত্তম ক্লাস্টারের উপর ভিত্তি করে পয়েন্টটিকে স্কেল করে"

msgid "The report has been created"
msgstr "রিপোর্টটি তৈরি করা হয়েছে"

msgid "The report will be sent to your email at"
msgstr "রিপোর্টটি আপনার ইমেলে পাঠানো হবে"

msgid ""
"The result of this query must be a value capable of numeric "
"interpretation e.g. 1, 1.0, or \"1\" (compatible with Python's float() "
"function)."
msgstr "এই ক্যোয়ারীর ফলাফল অবশ্যই একটি সংখ্যাসূচক ব্যাখ্যা করতে সক্ষম মান হতে হবে যেমন ১, ১.০, বা \"১\" (পাইথনের float() ফাংশনের সাথে সামঞ্জস্যপূর্ণ)।"

msgid "The result size exceeds the allowed limit."
msgstr "ফলাফলের আকার অনুমোদিত সীমা অতিক্রম করেছে।"

msgid "The results backend no longer has the data from the query."
msgstr "ফলাফল ব্যাকএন্ডে আর ক্যোয়ারী থেকে ডেটা নেই।"

msgid ""
"The results stored in the backend were stored in a different format, and "
"no longer can be deserialized."
msgstr "ব্যাকএন্ডে সংরক্ষিত ফলাফলগুলি একটি ভিন্ন বিন্যাসে সংরক্ষণ করা হয়েছিল, এবং আর ডিসিরিয়ালাইজ করা যাবে না।"

msgid "The rich tooltip shows a list of all series for that point in time"
msgstr "রিচ টুলটিপ সেই সময়ে সমস্ত সিরিজের একটি তালিকা দেখায়"

msgid ""
"The row limit set for the chart was reached. The chart may show partial "
"data."
msgstr "চার্টের জন্য নির্ধারিত সারি সীমা পৌঁছে গেছে। চার্টটি আংশিক ডেটা দেখাতে পারে।"

#, python-format
msgid ""
"The schema \"%(schema)s\" does not exist. A valid schema must be used to "
"run this query."
msgstr "স্কিমা \"%(schema)s\" বিদ্যমান নেই। এই ক্যোয়ারী চালানোর জন্য একটি বৈধ স্কিমা ব্যবহার করতে হবে।"

#, python-format
msgid ""
"The schema \"%(schema_name)s\" does not exist. A valid schema must be "
"used to run this query."
msgstr "স্কিমা \"%(schema_name)s\" বিদ্যমান নেই। এই ক্যোয়ারী চালানোর জন্য একটি বৈধ স্কিমা ব্যবহার করতে হবে।"

msgid "The schema of the submitted payload is invalid."
msgstr "জমা দেওয়া পেলোডের স্কিমা অবৈধ।"

msgid "The schema was deleted or renamed in the database."
msgstr "স্কিমাটি ডেটাবেস থেকে মুছে ফেলা বা পুনঃনামকরণ করা হয়েছে।"

msgid "The screenshot could not be downloaded. Please, try again later."
msgstr "স্ক্রিনশটটি ডাউনলোড করা যায়নি। অনুগ্রহ করে, পরে আবার চেষ্টা করুন।"

msgid "The screenshot has been downloaded."
msgstr "স্ক্রিনশটটি ডাউনলোড করা হয়েছে।"

msgid "The screenshot is being generated. Please, do not leave the page."
msgstr "স্ক্রিনশটটি তৈরি করা হচ্ছে। অনুগ্রহ করে, পৃষ্ঠাটি ছেড়ে যাবেন না।"

msgid "The service url of the layer"
msgstr "স্তরের পরিষেবা ইউআরএল"

msgid "The size of each cell in meters"
msgstr "প্রতিটি কোষের আকার মিটারে"

msgid "The size of the square cell, in pixels"
msgstr "বর্গাকার কোষের আকার, পিক্সেলে"

msgid "The slope to compute all sizes from. \"LINEAR\" only"
msgstr "সমস্ত আকার গণনা করার জন্য ঢাল। শুধুমাত্র \"LINEAR\""

msgid "The submitted payload failed validation."
msgstr "জমা দেওয়া পেলোড যাচাইকরণে ব্যর্থ হয়েছে।"

msgid "The submitted payload has the incorrect format."
msgstr "জমা দেওয়া পেলোডের বিন্যাস ভুল।"

msgid "The submitted payload has the incorrect schema."
msgstr "জমা দেওয়া পেলোডের স্কিমা ভুল।"

#, python-format
msgid ""
"The table \"%(table)s\" does not exist. A valid table must be used to run"
" this query."
msgstr "টেবিল \"%(table)s\" বিদ্যমান নেই। এই ক্যোয়ারী চালানোর জন্য একটি বৈধ টেবিল ব্যবহার করতে হবে।"

#, python-format
msgid ""
"The table \"%(table_name)s\" does not exist. A valid table must be used "
"to run this query."
msgstr "টেবিল \"%(table_name)s\" বিদ্যমান নেই। এই ক্যোয়ারী চালানোর জন্য একটি বৈধ টেবিল ব্যবহার করতে হবে।"

msgid "The table was deleted or renamed in the database."
msgstr "টেবিলটি ডেটাবেস থেকে মুছে ফেলা বা পুনঃনামকরণ করা হয়েছে।"

msgid ""
"The time column for the visualization. Note that you can define arbitrary"
" expression that return a DATETIME column in the table. Also note that "
"the filter below is applied against this column or expression"
msgstr "ভিজ্যুয়ালাইজেশনের জন্য সময় কলাম। মনে রাখবেন যে আপনি নির্বিচারে এক্সপ্রেশন সংজ্ঞায়িত করতে পারেন যা টেবিলে একটি DATETIME কলাম প্রদান করে। আরও মনে রাখবেন যে নীচের ফিল্টারটি এই কলাম বা এক্সপ্রেশনের বিরুদ্ধে প্রয়োগ করা হয়"

msgid ""
"The time granularity for the visualization. Note that you can type and "
"use simple natural language as in `10 seconds`, `1 day` or `56 weeks`"
msgstr "ভিজ্যুয়ালাইজেশনের জন্য সময় গ্রানুলারিটি। মনে রাখবেন যে আপনি `১০ সেকেন্ড`, `১ দিন` বা `৫৬ সপ্তাহ`-এর মতো সহজ স্বাভাবিক ভাষা টাইপ এবং ব্যবহার করতে পারেন"

msgid ""
"The time granularity for the visualization. Note that you can type and "
"use simple natural language as in `10 seconds`,`1 day` or `56 weeks`"
msgstr "ভিজ্যুয়ালাইজেশনের জন্য সময় গ্রানুলারিটি। মনে রাখবেন যে আপনি `১০ সেকেন্ড`, `১ দিন` বা `৫৬ সপ্তাহ`-এর মতো সহজ স্বাভাবিক ভাষা টাইপ এবং ব্যবহার করতে পারেন"

msgid ""
"The time granularity for the visualization. This applies a date "
"transformation to alter your time column and defines a new time "
"granularity. The options here are defined on a per database engine basis "
"in the Superset source code."
msgstr "ভিজ্যুয়ালাইজেশনের জন্য সময় গ্রানুলারিটি। এটি আপনার সময় কলাম পরিবর্তন করতে একটি তারিখ রূপান্তর প্রয়োগ করে এবং একটি নতুন সময় গ্রানুলারিটি সংজ্ঞায়িত করে। এখানকার বিকল্পগুলি সুপারসেট সোর্স কোডে প্রতি ডেটাবেস ইঞ্জিন ভিত্তিতে সংজ্ঞায়িত করা হয়।"

msgid ""
"The time range for the visualization. All relative times, e.g. \"Last "
"month\", \"Last 7 days\", \"now\", etc. are evaluated on the server using"
" the server's local time (sans timezone). All tooltips and placeholder "
"times are expressed in UTC (sans timezone). The timestamps are then "
"evaluated by the database using the engine's local timezone. Note one can"
" explicitly set the timezone per the ISO 8601 format if specifying either"
" the start and/or end time."
msgstr "ভিজ্যুয়ালাইজেশনের জন্য সময় পরিসীমা। সমস্ত আপেক্ষিক সময়, যেমন \"গত মাস\", \"গত ৭ দিন\", \"এখন\", ইত্যাদি সার্ভারে সার্ভারের স্থানীয় সময় (টাইমজোন ছাড়া) ব্যবহার করে মূল্যায়ন করা হয়। সমস্ত টুলটিপ এবং স্থানধারক সময় ইউটিসি (টাইমজোন ছাড়া) তে প্রকাশ করা হয়। টাইমস্ট্যাম্পগুলি তখন ইঞ্জিনের স্থানীয় টাইমজোন ব্যবহার করে ডেটাবেস দ্বারা মূল্যায়ন করা হয়। মনে রাখবেন যে শুরু এবং/অথবা শেষ সময় নির্দিষ্ট করলে কেউ আইএসও ৮৬০১ ফর্ম্যাট অনুযায়ী টাইমজোন স্পষ্টভাবে সেট করতে পারে।"

msgid ""
"The time unit for each block. Should be a smaller unit than "
"domain_granularity. Should be larger or equal to Time Grain"
msgstr "প্রতিটি ব্লকের জন্য সময় একক। domain_granularity-এর চেয়ে ছোট একক হওয়া উচিত। সময় গ্রেইনের চেয়ে বড় বা সমান হওয়া উচিত"

